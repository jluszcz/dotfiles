#!/usr/bin/env bash
set -euo pipefail

# Claude Code status line. Reads the session JSON on stdin and prints one
# colored line: repo, branch, context-usage bar, subscription rate-limit usage,
# code velocity, model (with reasoning effort, when applicable).
#
# Colors are truecolor values chosen for a LIGHT terminal background — text sits
# at or above ~4.5:1 contrast against white, bar glyphs above ~3.9:1.

input=$(cat)

# One jq pass; "-" stands in for absent fields so no line comes back empty and
# the fixed-order reads below stay aligned.
fields=$(printf '%s' "$input" | jq -r '
  [ (.session_id // "default"),
    (.workspace.current_dir // "-"),
    (.workspace.repo.name // "-"),
    (.model.display_name // "-"),
    (.effort.level // "-"),
    (.cost.total_lines_added // 0 | tostring),
    (.cost.total_lines_removed // 0 | tostring),
    (.context_window.used_percentage // "-" | tostring),
    (.rate_limits.five_hour.used_percentage // "-" | tostring),
    (.rate_limits.seven_day.used_percentage // "-" | tostring),
    (.rate_limits.five_hour.resets_at // "-" | tostring),
    (.rate_limits.seven_day.resets_at // "-" | tostring)
  ] | .[]')

{
  IFS= read -r session
  IFS= read -r dir
  IFS= read -r repo
  IFS= read -r model
  IFS= read -r effort
  IFS= read -r added
  IFS= read -r removed
  IFS= read -r used
  IFS= read -r five_hour
  IFS= read -r seven_day
  IFS= read -r five_hour_reset
  IFS= read -r seven_day_reset
} <<EOF
$fields
EOF

# Claude Code re-invokes this script far more often than the line visibly
# changes, and the git call below is the expensive part. Serve a cached line for
# 30 seconds, keyed per session so concurrent sessions never show each other's.
cache_dir="${TMPDIR:-/tmp}/claude-statusline"
cache_file="${cache_dir}/$(printf '%s' "$session" | tr -c 'A-Za-z0-9._-' '_')"
# GNU and BSD stat disagree about -f: BSD reads it as the format string, GNU as
# --file-system, which makes "%m" a filename and dumps filesystem details to
# stdout before failing -- poisoning the fallback. Probe the GNU spelling first,
# then require digits so an unrecognized stat is a cache miss, not a fatal
# arithmetic error below.
cache_mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || true)
case $cache_mtime in
  '' | *[!0-9]*) cache_mtime=0 ;;
esac
if [ "$(( $(date +%s) - cache_mtime ))" -lt 30 ]; then
  cat "$cache_file"
  exit 0
fi

if [ "$repo" = "-" ]; then
  repo=$(basename "$dir")
fi

branch=$(git -C "$dir" --no-optional-locks branch --show-current 2>/dev/null || true)
if [ -z "$branch" ]; then
  branch="no-git"
fi

if [ "$used" = "-" ]; then
  pct="--"
  filled=0
  usedint=0
  neutral=1
else
  usedint=$(printf '%.0f' "$used")
  pct="${usedint}%"
  filled=$(((usedint + 2) / 5))
  if [ "$filled" -gt 20 ]; then filled=20; fi
  neutral=0
fi

# Tier text colors run darker than the bar's equivalents: thin glyphs need more
# contrast than solid blocks do. Context usage and the rate-limit readouts share
# these thresholds, so a given color means the same severity wherever it appears.
tier_color() { # tier_color <percent-int>
  if [ "$1" -lt 20 ]; then
    printf '0;120;50'
  elif [ "$1" -lt 70 ]; then
    printf '150;100;0'
  elif [ "$1" -lt 90 ]; then
    printf '185;85;0'
  else
    printf '190;30;20'
  fi
}

# GNU and BSD date disagree about turning an epoch seconds value into a
# formatted date: GNU wants -d "@<epoch>", BSD wants -r <epoch>. Probe the GNU
# spelling first, same convention as the stat fallback above.
fmt_time() { # fmt_time <epoch> <strftime-format>
  date -d "@$1" "$2" 2>/dev/null || date -r "$1" "$2"
}

# Reset timestamps are only shown once a limit is nearly exhausted, so keep
# the format terse: weekday, hour with no leading zero, minutes only when
# non-zero, lowercase am/pm -- e.g. "Sat 1am" or "Sun 1:30pm".
format_reset() { # format_reset <epoch-seconds>
  local min day_hour ampm
  min=$(fmt_time "$1" '+%M')
  day_hour=$(fmt_time "$1" '+%a %-I')
  ampm=$(fmt_time "$1" '+%p' | tr '[:upper:]' '[:lower:]')
  if [ "$min" = "00" ]; then
    printf '%s%s' "$day_hour" "$ampm"
  else
    printf '%s:%s%s' "$day_hour" "$min" "$ampm"
  fi
}

if [ "$neutral" -eq 1 ]; then
  emoji="⏳"
  pct_color="140;140;140"
else
  pct_color=$(tier_color "$usedint")
  if [ "$usedint" -lt 20 ]; then
    emoji="🟢"
  elif [ "$usedint" -lt 70 ]; then
    emoji="⚡"
  elif [ "$usedint" -lt 90 ]; then
    emoji="🔥"
  else
    emoji="🚨"
  fi
fi

# Green -> amber -> red, precomputed in OkLCh with chroma pinned near the sRGB
# gamut edge. Interpolating these endpoints in plain RGB instead sags through a
# desaturated olive around the 20-40% marks that reads as a dirty grey block;
# every stop below holds saturation >=0.89.
ramp=(
  "15;139;62" "25;142;13" "74;138;13" "97;135;13" "113;133;13"
  "125;130;14" "136;128;14" "146;126;14" "155;124;14" "164;122;15"
  "170;118;14" "171;112;14" "172;106;13" "174;99;13" "175;92;12"
  "177;85;11" "180;76;11" "183;65;10" "187;49;9" "194;17;9"
)
track="235;235;235"

esc=$(printf '\033')

paint() { # paint <r;g;b> <attrs> <text>
  printf '%s[%s38;2;%sm%s%s[0m' "$esc" "$2" "$1" "$3" "$esc"
}

bar=""
i=1
while [ "$i" -le 20 ]; do
  if [ "$i" -le "$filled" ]; then
    block=$(paint "${ramp[$((i - 1))]}" "" "█")
  else
    block=$(paint "$track" "" "█")
  fi
  bar="${bar}${block}"
  i=$((i + 1))
done

sep=$(paint "140;140;140" "" "|")
repo_seg=$(paint "146;94;0" "1;" "$repo")
branch_seg=$(paint "0;109;119" "1;" "🌱 (${branch})")
pct_seg=$(paint "$pct_color" "" "$pct")
added_seg=$(paint "0;120;50" "" "+${added}")
removed_seg=$(paint "190;30;20" "" "-${removed}")
# Effort is only present when the current model supports reasoning effort;
# omit the "(...)" entirely rather than print a placeholder.
model_text="🤖 ${model}"
if [ "$effort" != "-" ]; then
  model_text="${model_text} (${effort})"
fi
model_seg=$(paint "150;40;160" "" "$model_text")

# Session/weekly rate-limit usage is only present once the account has an
# active Claude.ai subscription and at least one API response has landed;
# omit the segment entirely rather than print a placeholder.
rate_parts=""
if [ "$five_hour" != "-" ]; then
  fivepct=$(printf '%.0f' "$five_hour")
  five_text="5h:${fivepct}%"
  if [ "$fivepct" -gt 95 ] && [ "$five_hour_reset" != "-" ]; then
    five_text="${five_text} ($(format_reset "$five_hour_reset"))"
  fi
  rate_parts=$(paint "$(tier_color "$fivepct")" "" "$five_text")
fi
if [ "$seven_day" != "-" ]; then
  weekpct=$(printf '%.0f' "$seven_day")
  week_text="7d:${weekpct}%"
  if [ "$weekpct" -gt 95 ] && [ "$seven_day_reset" != "-" ]; then
    week_text="${week_text} ($(format_reset "$seven_day_reset"))"
  fi
  week_seg=$(paint "$(tier_color "$weekpct")" "" "$week_text")
  if [ -n "$rate_parts" ]; then
    rate_parts="${rate_parts} ${week_seg}"
  else
    rate_parts="$week_seg"
  fi
fi

out="${repo_seg} ${sep} ${branch_seg} ${sep} ${bar} ${emoji} ${pct_seg}"
if [ -n "$rate_parts" ]; then
  out="${out} ${sep} ${rate_parts}"
fi
out="${out} ${sep} ${added_seg}/${removed_seg} ${sep} ${model_seg}"

mkdir -p "$cache_dir"
printf '%s\n' "$out" | tee "$cache_file"
