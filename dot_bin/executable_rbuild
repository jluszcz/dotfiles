#!/usr/bin/env bash
# Builds the release binary of every project launched via rustbin from a script in ~/.bin.
# Projects are discovered from those scripts at run time, so a new rustbin wrapper needs no change here.

set -u

check=false

while [ $# -gt 0 ]; do
    case "$1" in
        -c|--check)
            check=true
            shift
            ;;
        -h|--help)
            echo "Usage: rbuild [-c|--check]"
            echo ""
            echo "Build the release binary of every project launched via rustbin."
            echo ""
            echo "Options:"
            echo "  -c, --check    First run cball (build, test, clippy, fmt) in each project"
            echo "  -h, --help     Show this help message"
            exit 0
            ;;
        *)
            echo "rbuild: unknown option $1" >&2
            exit 1
            ;;
    esac
done

# cball is a zsh function from .zshrc, which only an interactive zsh loads. stdin is the loop's
# directory list, so keep the shell from reading it.
run_checks() {
    zsh -ic cball </dev/null
}

failed=()

while IFS= read -r dir; do
    if [[ ! -d "${dir}" ]]; then
        echo "Skipping ${dir}: not found"
        continue
    fi

    echo "==> ${dir}"
    pushd "${dir}" >/dev/null || { failed+=("${dir}"); continue; }
    if [[ "${check}" == true ]] && ! run_checks; then
        failed+=("${dir}")
    elif ! cargo build --release; then
        failed+=("${dir}")
    fi
    popd >/dev/null || exit 1
done < <(
    grep -h '^rustbin ' "$HOME"/.bin/* 2>/dev/null \
        | sed -e 's/^rustbin "\([^"]*\)".*/\1/' -e "s|\$HOME|${HOME}|" \
        | sort -u
)

if (( ${#failed[@]} > 0 )); then
    echo "Failed in:" >&2
    printf '  %s\n' "${failed[@]}" >&2
    exit 1
fi
