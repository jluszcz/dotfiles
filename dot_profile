export PATH=$HOME/.bin:$PATH

case $- in
    *i*)
        if [ -z "$TMUX" ] && [ -n "$SSH_TTY" ]; then
            tmux attach-session -t ssh || tmux new-session -s ssh
        fi
        ;;
esac

short_pwd() {
    echo "$PWD" | sed "s|^$HOME|~|" | awk -F'/' 'NF>2{print $(NF-1)"/"$NF; next} {print}'
}

PS1='\[\033[1m\][Synology]\[\033[0m\] $(short_pwd) » '

[ -f "$HOME/.dircolors" ] && eval "$(dircolors "$HOME/.dircolors")"

alias l=ls
alias ll='ls -lh'

# copy rather than sync: the bucket has no versioning, so an unmounted or
# half-mounted /volume1 would propagate as permanent deletions. --immutable
# makes an unexpected size change an error instead of a replacement, which
# would also trigger Deep Archive's 180-day early-deletion charge.
rc() {
    rclone copy /volume1/Plex/Library s3-media:jluszcz-physical-media \
        --exclude '.DS_Store' \
        --exclude '@eaDir/**' \
        --exclude '/Movies/Kundun (1997).mkv' \
        --size-only \
        --immutable \
        --fast-list \
        --transfers 2 \
        --retries 10 \
        --log-file "$HOME/rclone-media.log" \
        --log-level INFO \
        --progress "$@"
}
