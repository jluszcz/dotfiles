export PATH=$HOME/.bin:$PATH

case $- in
    *i*)
        if [ -z "$TMUX" ] && [ -n "$SSH_TTY" ]; then
            tmux attach-session -t ssh || tmux new-session -s ssh
        fi
        ;;
esac

short_pwd() {
    echo "$PWD" | sed "s|^$HOME|~|" | awk -F'/' 'NF>2{print $(NF-1)"/"$NF; next} {print}'
}

PS1='\[\033[1m\][Synology]\[\033[0m\] $(short_pwd) » '

# DSM defaults HISTFILE to /var/tmp, which doesn't survive a reboot. Sessions
# live inside tmux and are detached rather than exited, so bash never writes
# history on exit; PROMPT_COMMAND appends each command as it runs. Bash reads
# HISTFILE only at startup, so PROMPT_COMMAND also reloads it to pick up what
# other long-lived panes have appended since — otherwise Ctrl-R can't see them.
# `history -c; history -r` rather than `history -n`: -n tracks its position as a
# line count, which goes stale once another pane appends before this one does,
# skipping that pane's lines and re-reading this pane's own.
export HISTFILE="$HOME/.sh_history"
export HISTSIZE=10000
export HISTFILESIZE=10000
# `history -a` creates a missing HISTFILE only once there is a command to
# write, so the reload at the first prompt would fail on it; create it here,
# 0600 as bash would, since history can hold secrets typed on the command line.
[ -f "$HISTFILE" ] || (umask 077 && : > "$HISTFILE")
PROMPT_COMMAND='history -a; history -c; history -r'

[ -f "$HOME/.dircolors" ] && eval "$(dircolors "$HOME/.dircolors")"

alias l=ls
alias ll='ls -lh'

# copy rather than sync: the bucket has no versioning, so an unmounted or
# half-mounted /volume1 would propagate as permanent deletions. A size change
# overwrites the bucket's copy, so replacing a file within 180 days of its
# upload incurs Deep Archive's early-deletion charge, and the old copy is
# unrecoverable — a truncated or corrupt local file replaces a good archive.
# `rc --immutable` refuses any replacement for a run that shouldn't make one.
rc() {
    rclone copy /volume1/Plex/Library s3-media:jluszcz-physical-media \
        --exclude '.DS_Store' \
        --exclude '@eaDir/**' \
        --size-only \
        --fast-list \
        --transfers 2 \
        --retries 10 \
        --log-file "$HOME/rclone-media.log" \
        --log-level INFO \
        --progress "$@"
}
