# Path to your oh-my-zsh installation.
export ZSH="{{ .chezmoi.homeDir }}/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/robbyrussell/oh-my-zsh/wiki/Themes
ZSH_THEME="gallifrey-custom"

# Automatically update without prompting.
DISABLE_UPDATE_PROMPT="true"

# Change the command execution time stamp shown in the history
# command output.
HIST_STAMPS="yyyy-mm-dd"

# Remove older duplicates when a command is re-added
setopt HIST_IGNORE_ALL_DUPS

# Ignore commands starting with a space
setopt HIST_IGNORE_SPACE

# Share history across all sessions, de-duplicated
setopt SHARE_HISTORY

{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_NO_ENV_HINTS=1
export PATH=/opt/homebrew/sbin:$PATH
export PATH=/opt/homebrew/bin:$PATH
{{- end }}

# Which plugins would you like to load?
# Standard plugins can be found in ~/.oh-my-zsh/plugins/*
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git direnv)

source $ZSH/oh-my-zsh.sh

# Git Aliases
alias g='git'
alias gb='git branch'
alias gd='git diff'
alias gl='git log'
alias gp='git pull'
alias gr='git rebase -i'
alias gst='git status'
alias gsw='git switch'
alias wip="git add . && git commit -a -m '[Work In Progress]' --allow-empty"

# origin's default branch name (e.g. main), read from the local origin/HEAD ref.
# That ref is absent in some clones, so fall back to asking the remote and recording it.
_default_branch() {
    local ref
    ref=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    if [ -z "$ref" ]; then
        git remote set-head origin --auto >/dev/null || return 1
        ref=$(git symbolic-ref --short refs/remotes/origin/HEAD) || return 1
    fi
    echo "${ref#origin/}"
}

# Switch to the default branch, pull, and delete the branch you were on
gmerge() {
    local branch base
    branch=$(git symbolic-ref --short HEAD) || return 1
    base=$(_default_branch) || return 1
    if [ "$branch" = "$base" ]; then
        return 0
    fi
    git switch "$base" && git pull && git branch -D "$branch"
}

# /tmp/<repo>-<branch>, the worktree location shared by gct and grt. Derived from the
# common git dir so it resolves to the same path from inside a worktree.
_worktree_path() {
    local common
    common=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
    echo "/tmp/$(basename "$(dirname "$common")")-$1"
}

# Create a worktree for a new branch off origin's default branch
gct() {
    if [ -z "$1" ]; then
        echo "usage: gct <branch>" >&2
        return 1
    fi
    local dir base
    dir=$(_worktree_path "$1") || return 1
    git fetch origin || return 1
    base=$(_default_branch) || return 1
    git worktree add -b "$1" "$dir" "origin/$base"
}

# oh-my-zsh's git plugin claims grt as a cd-to-repo-root alias, which would shadow
# this function at parse time.
unalias grt 2>/dev/null

# Remove a worktree created by gct
grt() {
    if [ -z "$1" ]; then
        echo "usage: grt <branch>" >&2
        return 1
    fi
    local dir
    dir=$(_worktree_path "$1") || return 1
    git worktree remove "$dir"
}

# Misc.
alias l=ls
alias ll='ls -lh'

alias src='source {{ .chezmoi.homeDir }}/.zshrc'

alias cl=claude
alias tf=terraform

# Rust
if [ -f "{{ .chezmoi.homeDir }}/.cargo/env" ]; then
    source "{{ .chezmoi.homeDir }}/.cargo/env"

    cbuild() { cargo build --all-features }

    ctest() { cargo test --all-features }

    cclip() { cargo clippy --all-features -- -D warnings }

    cball() {
        cbuild && ctest && cclip && cargo fmt
    }

    rup() {
        local branch="Deps-$RANDOM" base
        base=$(_default_branch) || return 1
        git switch "$base" && git pull && git switch -C "$branch" -t "origin/$base" && cargo update && cargo outdated --root-deps-only || return 1
        if git diff --quiet; then
            git switch "$base" && git branch -D "$branch"
            return $?
        fi

        cball && g commit -a -m "Update dependencies" && git push origin HEAD && gh pr create --title "Update dependencies" --body "" --base "$base" --head "$branch" || return 1

        echo -e "\nRun 'gmerge' to switch back to $base and delete the branch once merged\n"
    }

    {{- if eq .chezmoi.os "darwin" }}
    # Wrap rustup so a successful `rustup update` that actually installs a new
    # toolchain offers to schedule an "Update Rust" reminder for the next release
    # (see ~/.bin/rust-reminder). Nothing happens when the toolchain is unchanged.
    rustup() {
        if [ "${1:-}" = "update" ]; then
            local tmp rc
            tmp=$(mktemp)
            command rustup "$@" 2>&1 | tee "$tmp"
            rc=${pipestatus[1]}
            if [ "$rc" -eq 0 ] && grep -q 'updated -' "$tmp"; then
                rust-reminder
            fi
            rm -f "$tmp"
            return "$rc"
        fi
        command rustup "$@"
    }
    {{- end }}
fi

