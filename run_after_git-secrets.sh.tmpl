#!/usr/bin/env sh

set -eu

# .gitconfig points init.templateDir here, so new clones get git-secrets' hooks
# once this is populated. Runs after the Brewfile has installed git-secrets.
TEMPLATE_DIR={{ joinPath .chezmoi.homeDir ".git-templates" "git-secrets" | quote }}
if [ ! -d "$TEMPLATE_DIR/hooks" ] && command -v git-secrets > /dev/null; then
    git secrets --install "$TEMPLATE_DIR"
fi
