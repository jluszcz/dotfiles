#!/usr/bin/env sh

set -eu

{{- if eq .chezmoi.os "darwin" }}
# Symlink preferences into the right places
SUBLIME_PREFS_DIR="$HOME/Library/Application Support/Sublime Text/Packages/User"
if [ -d "${SUBLIME_PREFS_DIR}" ]; then
    rm -f "${SUBLIME_PREFS_DIR}/Preferences.sublime-settings"
    ln -svfh "$HOME/.config/Sublime.json" "${SUBLIME_PREFS_DIR}/Preferences.sublime-settings"
fi

VSCODE_PREFS_DIR="$HOME/Library/Application Support/Code/User"
if [ -d "${VSCODE_PREFS_DIR}" ]; then
    rm -f "${VSCODE_PREFS_DIR}/settings.json"
    ln -svfh "$HOME/.config/VSCode.json" "${VSCODE_PREFS_DIR}/settings.json"
fi

# Symlink MisterManager's database out of Dropbox
if [ -f "$HOME/Dropbox/Money/money.db" ]; then
    MISTERMANAGER_DIR="$HOME/.local/share/mistermanager"
    # A regular file here is a local database, not a stale link, so leave it alone
    if [ ! -e "${MISTERMANAGER_DIR}/money.db" ] || [ -L "${MISTERMANAGER_DIR}/money.db" ]; then
        mkdir -p "${MISTERMANAGER_DIR}"
        ln -svfh "$HOME/Dropbox/Money/money.db" "${MISTERMANAGER_DIR}/money.db"
    fi
fi

# Symlink Paychecker's database out of Dropbox
if [ -f "$HOME/Dropbox/Money/paychecks.db" ]; then
    PAYCHECKER_DIR="$HOME/.local/share/paychecker"
    # A regular file here is a local database, not a stale link, so leave it alone
    if [ ! -e "${PAYCHECKER_DIR}/paychecks.db" ] || [ -L "${PAYCHECKER_DIR}/paychecks.db" ]; then
        mkdir -p "${PAYCHECKER_DIR}"
        ln -svfh "$HOME/Dropbox/Money/paychecks.db" "${PAYCHECKER_DIR}/paychecks.db"
    fi
fi

# Symlink Funder's database out of Dropbox
if [ -f "$HOME/Dropbox/Money/funder.db" ]; then
    FUNDER_DIR="$HOME/.local/share/funder"
    # A regular file here is a local database, not a stale link, so leave it alone
    if [ ! -e "${FUNDER_DIR}/funder.db" ] || [ -L "${FUNDER_DIR}/funder.db" ]; then
        mkdir -p "${FUNDER_DIR}"
        ln -svfh "$HOME/Dropbox/Money/funder.db" "${FUNDER_DIR}/funder.db"
    fi
fi

# Copy Obsidian files into ~/Dropbox
if [ -d "$HOME/Dropbox" ] && [ -f "$HOME/.obsidian/Daily Template.md" ]; then
    mkdir -p "$HOME/Dropbox/Obsidian/Templates"
    rm -f "$HOME/Dropbox/Obsidian/Templates/Daily Template.md"
    cp "$HOME/.obsidian/Daily Template.md" "$HOME/Dropbox/Obsidian/Templates/"
fi

# Symlink .env files into their projects
if [ -d "$HOME/Documents/Programs/EndTimes" ]; then
    rm -f "$HOME/Documents/Programs/EndTimes/.dev.vars"
    ln -svfh "$HOME/.config/envrc/endtimes" "$HOME/Documents/Programs/EndTimes/.dev.vars"
fi

if [ -d "$HOME/Documents/Programs/JakeSky-rs" ]; then
    rm -f "$HOME/Documents/Programs/JakeSky-rs/.envrc"
    ln -svfh "$HOME/.config/envrc/jakesky" "$HOME/Documents/Programs/JakeSky-rs/.envrc"
fi

if [ -d "$HOME/Documents/Programs/LottoCheck" ]; then
    rm -f "$HOME/Documents/Programs/LottoCheck/.dev.vars"
    ln -svfh "$HOME/.config/envrc/lottocheck" "$HOME/Documents/Programs/LottoCheck/.dev.vars"
fi

if [ -d "$HOME/Documents/Programs/mbtalerts" ]; then
    rm -f "$HOME/Documents/Programs/mbtalerts/.envrc"
    ln -svfh "$HOME/.config/envrc/mbtalerts" "$HOME/Documents/Programs/mbtalerts/.envrc"
fi

if [ -d "$HOME/Documents/Programs/plexport" ]; then
    rm -f "$HOME/Documents/Programs/plexport/.envrc"
    ln -svfh "$HOME/.config/envrc/plexport" "$HOME/Documents/Programs/plexport/.envrc"
fi

if [ -d "$HOME/Documents/Programs/TvTalk" ]; then
    rm -f "$HOME/Documents/Programs/TvTalk/.dev.vars"
    ln -svfh "$HOME/.config/envrc/tvtalk" "$HOME/Documents/Programs/TvTalk/.dev.vars"
fi

if [ -d "$HOME/Documents/Programs/Seen" ]; then
    rm -f "$HOME/Documents/Programs/Seen/.env"
    ln -svfh "$HOME/.config/envrc/seen" "$HOME/Documents/Programs/Seen/.env"
fi

if [ -d "$HOME/Documents/Programs/Spoilies" ]; then
    rm -f "$HOME/Documents/Programs/Spoilies/.envrc"
    ln -svfh "$HOME/.config/envrc/spoilies" "$HOME/Documents/Programs/Spoilies/.envrc"
fi
# End .env files

# Symlink ListOfLists' local generator bucket to the template and each list's JSON
LOL_GENERATOR_DIR="$HOME/Documents/Programs/ListOfLists-rs/buckets/generator"
if [ -d "$HOME/Documents/Programs/ListOfLists-rs" ]; then
    mkdir -p "${LOL_GENERATOR_DIR}"
    LOL_TEMPLATE="${LOL_GENERATOR_DIR}/index.template"
    # A regular file here is a local template, not a stale link, so leave it alone
    if [ -f "$HOME/Documents/Programs/ListOfLists-rs/index.template" ] \
        && { [ ! -e "${LOL_TEMPLATE}" ] || [ -L "${LOL_TEMPLATE}" ]; }; then
        # Relative, so the link survives the clone moving
        ln -svfh ../../index.template "${LOL_TEMPLATE}"
    fi

    for LOL_LIST in burgerl.ist:BurgerList/burgerlist.json \
                    moviel.ist:MovieList/movielist.json \
                    starl.ist:StarList/starlist.json; do
        LOL_LINK="${LOL_GENERATOR_DIR}/${LOL_LIST%%:*}.json"
        LOL_TARGET="$HOME/Documents/${LOL_LIST#*:}"
        # A regular file here is a local copy of the list, not a stale link, so leave it alone
        if [ -f "${LOL_TARGET}" ] && { [ ! -e "${LOL_LINK}" ] || [ -L "${LOL_LINK}" ]; }; then
            ln -svfh "${LOL_TARGET}" "${LOL_LINK}"
        fi
    done
fi

{{- end }}

# Symlink oh-my-zsh theme; -n rather than macOS-only -h so this also runs on Linux
THEME_DIR="$HOME/.oh-my-zsh/custom/themes"
if [ -d "${THEME_DIR}" ]; then
    ln -svfn "$HOME/.config/gallifrey-custom.zsh-theme" "${THEME_DIR}/"
fi
